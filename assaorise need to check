 const names={
  surface:'Surface Mount',
  bottom:'Bottom Load / Swing Controls',
  drive:'Sliding Door Drive & Sensors',
  hardware:'Sliding Door Hardware & Kits'
 };
 const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const mailLink=p=>'mailto:'+email+'?subject='+encodeURIComponent('Enquiry for '+p[1]+' - '+p[2]);
 const image=p=>base+p[6];

 function makeCard(p){
  const words=[p[1],p[2],p[3],p[4],p[5],p[7]].join(' ').toLowerCase();
  return `<article class="oa-card" data-cat="${p[0]}" data-search="${esc(words)}">
   <div class="oa-card-image" data-zoom tabindex="0" role="button" aria-label="Zoom ${esc(p[2])}">
    <img src="${image(p)}" alt="${esc(p[2])} - ${esc(p[1])}" loading="lazy">
    <span class="oa-zoom">Click to Zoom</span>
   </div>
   <div class="oa-card-body">
    <span class="oa-tag">${esc(p[7])}</span>
    <div class="oa-part">${esc(p[1])}</div>
    <h3>${esc(p[2])}</h3>
    <p class="oa-desc">${esc(p[3])}</p>
    <div class="oa-spec">
     <p><strong>Compatibility:</strong> ${esc(p[4])}</p>
     <p><strong>Finish / Type:</strong> ${esc(p[5])}</p>
    </div>
    <div class="oa-actions">
     <a class="oa-btn" href="${mailLink(p)}">Inquire / Quote</a>
     <button class="oa-btn oa-btn-outline" type="button" data-details>Details</button>
    </div>
   </div>
  </article>`;
 }

 const gridMap={
  surface:root.querySelector('#oa-grid-surface'),
  bottom:root.querySelector('#oa-grid-bottom'),
  drive:root.querySelector('#oa-grid-drive'),
  hardware:root.querySelector('#oa-grid-hardware')
 };
 P.forEach(p=>gridMap[p[0]].insertAdjacentHTML('beforeend',makeCard(p)));

 root.querySelector('#oa-matrix-body').innerHTML=P.map(p=>`<tr>
  <td>${esc(names[p[0]])}</td>
  <td>${esc(p[1])}</td>
  <td>${esc(p[2])}</td>
  <td>${esc(p[4])}</td>
  <td>${esc(p[5])}</td>
  <td class="oa-availability">Contact Omega to confirm</td>
 </tr>`).join('');

 const cards=[...root.querySelectorAll('.oa-card')];
 const filters=[...root.querySelectorAll('.oa-filter')];
 const search=root.querySelector('#oa-search');
 const results=root.querySelector('#oa-results');
 const empty=root.querySelector('#oa-empty');
 let active='all';

 function update(){
  const q=search.value.trim().toLowerCase();
  let count=0;
  cards.forEach(card=>{
   const visible=(active==='all'||card.dataset.cat===active)&&(!q||card.dataset.search.includes(q));
   card.hidden=!visible;
   if(visible)count++;
  });
  Object.keys(gridMap).forEach(k=>{
   const section=root.querySelector('[data-section="'+k+'"]');
   section.hidden=!cards.some(c=>c.dataset.cat===k&&!c.hidden);
  });
  results.textContent='Showing '+count+' of '+P.length+' parts';
  empty.classList.toggle('show',count===0);
 }
 filters.forEach(btn=>btn.addEventListener('click',()=>{
  active=btn.dataset.filter;
  filters.forEach(b=>b.classList.toggle('active',b===btn));
  update();
 }));
 search.addEventListener('input',update);
 root.querySelector('#oa-reset').addEventListener('click',()=>{
  active='all';search.value='';
  filters.forEach(b=>b.classList.toggle('active',b.dataset.filter==='all'));
  update();
 });

 const modal=root.querySelector('#oa-modal');
 const content=root.querySelector('#oa-modal-content');
 function show(p,zoom){
  content.innerHTML=zoom
   ?`<img src="${image(p)}" alt="${esc(p[2])}"><h3>${esc(p[2])}</h3><p>${esc(p[1])}</p>`
   :`<span class="oa-eyebrow">${esc(names[p[0]])}</span>
     <h3>${esc(p[2])}</h3><p><strong>Part Number:</strong> ${esc(p[1])}</p>
     <p>${esc(p[3])}</p>
     <div class="oa-modal-spec"><strong>Compatibility:</strong> ${esc(p[4])}<br><strong>Finish / Type:</strong> ${esc(p[5])}</div>
     <a class="oa-btn" href="${mailLink(p)}">Inquire / Quote</a>`;
  modal.classList.add('open');modal.setAttribute('aria-hidden','false');
  document.body.style.overflow='hidden';
 }
 function close(){
  modal.classList.remove('open');modal.setAttribute('aria-hidden','true');
  document.body.style.overflow='';
 }
 cards.forEach((card,i)=>{
  const p=P[i],zoom=card.querySelector('[data-zoom]');
  zoom.addEventListener('click',()=>show(p,true));
  zoom.addEventListener('keydown',e=>{
   if(e.key==='Enter'||e.key===' '){e.preventDefault();show(p,true)}
  });
  card.querySelector('[data-details]').addEventListener('click',()=>show(p,false));
 });
 root.querySelector('#oa-close').addEventListener('click',close);
 modal.addEventListener('click',e=>{if(e.target===modal)close()});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))close()});
 update();
})();
</script>
</div>
