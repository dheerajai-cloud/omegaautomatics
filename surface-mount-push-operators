
<div id="omega-push-redesign">

<style>
#omega-push-redesign{
  --or-red:#D92012;
  --or-gold:#C5A059;
  --or-dark:#111214;
  --or-navy:#0B1320;
  --or-paper:#FAF9F6;
  --or-white:#FFFFFF;
  --or-text:#242321;
  --or-muted:#716E69;
  --or-line:#E7E3DC;
  font-family:inherit;
  color:var(--or-text);
  line-height:1.7;
  overflow:hidden;
}
#omega-push-redesign *{box-sizing:border-box}
#omega-push-redesign h1,
#omega-push-redesign h2,
#omega-push-redesign h3,
#omega-push-redesign h4{
  font-family:inherit;
  line-height:1.18;
  font-weight:600;
  margin:0 0 16px;
  color:inherit;
}
#omega-push-redesign p{
  font-family:inherit;
  font-size:14px;
  line-height:1.85;
  margin:0 0 17px;
}
#omega-push-redesign img{max-width:100%;height:auto}
#omega-push-redesign a{text-decoration:none}
#omega-push-redesign .or-wrap{
  width:min(1160px,calc(100% - 48px));
  margin:auto;
}
#omega-push-redesign .or-section{padding:88px 0}
#omega-push-redesign .or-paper{background:var(--or-paper)}
#omega-push-redesign .or-eyebrow{
  display:block;
  color:var(--or-gold);
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:2px;
  margin-bottom:15px;
}
#omega-push-redesign .or-heading{
  font-size:clamp(30px,3.5vw,43px);
  letter-spacing:-.5px;
}
#omega-push-redesign .or-description{
  color:var(--or-muted);
  max-width:710px;
}
#omega-push-redesign .or-center{text-align:center}
#omega-push-redesign .or-center .or-description{margin-left:auto;margin-right:auto}
#omega-push-redesign .or-line{
  width:42px;
  height:2px;
  background:var(--or-gold);
  margin:22px 0;
}
#omega-push-redesign .or-btn{
  display:inline-flex;
  justify-content:center;
  align-items:center;
  gap:8px;
  padding:13px 21px;
  min-height:44px;
  background:var(--or-red);
  border:1px solid var(--or-red);
  color:#fff!important;
  font-family:inherit;
  font-size:11px;
  font-weight:700;
  letter-spacing:.35px;
  text-transform:uppercase;
  transition:.2s ease;
}
#omega-push-redesign .or-btn:hover{
  background:#B91D12;
  border-color:#B91D12;
  color:#fff!important;
}
#omega-push-redesign .or-btn-ghost{
  background:transparent;
  border-color:rgba(255,255,255,.55);
  color:#fff!important;
}
#omega-push-redesign .or-btn-ghost:hover{
  background:#fff;
  color:var(--or-dark)!important;
}
#omega-push-redesign .or-text-link{
  display:inline-block;
  color:var(--or-red);
  font-size:12px;
  font-weight:700;
  border-bottom:1px solid var(--or-gold);
  padding-bottom:3px;
}
#omega-push-redesign .or-small-label{
  color:var(--or-gold);
  font-size:10px;
  text-transform:uppercase;
  font-weight:700;
  letter-spacing:1.5px;
}

/* HERO - NEW COMPOSITION */
#omega-push-redesign .or-hero{
  position:relative;
  color:#fff;
  background:
    linear-gradient(105deg,rgba(7,8,10,.97),rgba(7,8,10,.87) 60%,rgba(7,8,10,.77)),
    url("https://omegaautomatics.com/images/surface-mount-lh-push.png") center/cover no-repeat;
  padding:82px 0 75px;
}
#omega-push-redesign .or-hero:after{
  content:"";
  position:absolute;
  left:0;
  bottom:0;
  width:100%;
  height:3px;
  background:var(--or-gold);
  opacity:.8;
}
#omega-push-redesign .or-hero-grid{
  position:relative;
  z-index:1;
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:55px;
  align-items:center;
}
#omega-push-redesign .or-hero h1{
  color:#fff;
  font-size:clamp(43px,5.4vw,66px);
  font-weight:500;
  letter-spacing:-1.2px;
  line-height:1.02;
  margin-bottom:22px;
}
#omega-push-redesign .or-hero h1 em{
  color:var(--or-gold);
  font-weight:500;
}
#omega-push-redesign .or-hero-copy{max-width:590px}
#omega-push-redesign .or-hero-copy p{
  color:rgba(255,255,255,.8);
  max-width:530px;
}
#omega-push-redesign .or-hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-top:27px;
}
#omega-push-redesign .or-hero-meta{
  display:flex;
  flex-wrap:wrap;
  gap:20px;
  border-top:1px solid rgba(255,255,255,.18);
  margin-top:34px;
  padding-top:19px;
}
#omega-push-redesign .or-hero-meta span{
  color:rgba(255,255,255,.75);
  font-size:11px;
}
#omega-push-redesign .or-hero-meta strong{
  color:var(--or-gold);
  font-size:12px;
  display:block;
}
#omega-push-redesign .or-hero-showcase{
  position:relative;
  padding:25px 25px 25px 0;
}
#omega-push-redesign .or-hero-showcase:before{
  content:"";
  position:absolute;
  right:0;
  top:0;
  width:80%;
  height:100%;
  border:1px solid rgba(197,160,89,.55);
}
#omega-push-redesign .or-hero-main-image{
  position:relative;
  background:#fff;
  padding:22px;
  z-index:1;
  min-height:300px;
  display:flex;
  align-items:center;
  justify-content:center;
}
#omega-push-redesign .or-hero-main-image img{
  width:100%;
  height:240px;
  object-fit:contain;
}
#omega-push-redesign .or-image-caption{
  position:relative;
  z-index:2;
  display:flex;
  justify-content:space-between;
  gap:15px;
  color:#fff;
  font-size:11px;
  padding:15px 0 0 15px;
}
#omega-push-redesign .or-image-caption strong{
  color:var(--or-gold);
}

/* SECTION NAV */
#omega-push-redesign .or-anchorbar{
  background:#fff;
  border-bottom:1px solid var(--or-line);
}
#omega-push-redesign .or-anchor-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  padding:16px 0;
  overflow-x:auto;
}
#omega-push-redesign .or-anchor-inner a{
  white-space:nowrap;
  color:#45413C;
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.5px;
}
#omega-push-redesign .or-anchor-inner a:hover{color:var(--or-red)}

/* INTRO EDITORIAL */
#omega-push-redesign .or-intro-grid{
  display:grid;
  grid-template-columns:.75fr 1.25fr;
  gap:65px;
  align-items:start;
}
#omega-push-redesign .or-intro-aside{
  border-top:2px solid var(--or-gold);
  padding-top:20px;
}
#omega-push-redesign .or-intro-aside .or-number{
  font-size:clamp(54px,7vw,82px);
  line-height:1;
  color:var(--or-gold);
  font-weight:400;
  display:block;
  margin-bottom:13px;
}
#omega-push-redesign .or-intro-aside p{
  font-size:12px;
  color:var(--or-muted);
}
#omega-push-redesign .or-intro-content h2{max-width:650px}
#omega-push-redesign .or-intro-content p{color:var(--or-muted)}
#omega-push-redesign .or-intro-bottom{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--or-line);
  margin-top:27px;
  padding-top:18px;
  gap:20px;
}
#omega-push-redesign .or-intro-bottom strong{
  display:block;
  font-size:12px;
  margin-bottom:5px;
}
#omega-push-redesign .or-intro-bottom span{
  display:block;
  font-size:11px;
  color:var(--or-muted);
}

/* CONFIGURATION SELECTOR */
#omega-push-redesign .or-config-section{background:#F5F3EF}
#omega-push-redesign .or-config-heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:30px;
  margin-bottom:36px;
}
#omega-push-redesign .or-config-heading .or-heading{max-width:570px}
#omega-push-redesign .or-config-heading p{
  max-width:370px;
  color:var(--or-muted);
  font-size:13px;
  margin-bottom:3px;
}
#omega-push-redesign .or-config-list{
  border-top:1px solid #DAD5CC;
}
#omega-push-redesign .or-config-row{
  display:grid;
  grid-template-columns:75px 1.1fr 1fr 1fr 150px;
  gap:22px;
  align-items:center;
  padding:21px 15px;
  border-bottom:1px solid #DAD5CC;
  transition:background .2s ease;
}
#omega-push-redesign .or-config-row:hover{background:#fff}
#omega-push-redesign .or-config-index{
  color:var(--or-gold);
  font-size:22px;
  font-weight:400;
}
#omega-push-redesign .or-config-image{
  background:#fff;
  padding:8px;
  height:88px;
  display:flex;
  align-items:center;
  justify-content:center;
}
#omega-push-redesign .or-config-image img{
  width:100%;
  height:70px;
  object-fit:contain;
}
#omega-push-redesign .or-config-name h3{
  font-size:17px;
  margin:0 0 5px;
}
#omega-push-redesign .or-config-name span{
  color:var(--or-gold);
  font-size:10px;
  font-weight:700;
  letter-spacing:1px;
}
#omega-push-redesign .or-config-detail{
  color:var(--or-muted);
  font-size:12px;
}
#omega-push-redesign .or-config-row .or-text-link{
  justify-self:end;
  white-space:nowrap;
}

/* APPLICATIONS */
#omega-push-redesign .or-app-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:70px;
  align-items:center;
}
#omega-push-redesign .or-app-visual{
  background:#F3F1EC;
  padding:38px;
  min-height:360px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
#omega-push-redesign .or-app-visual img{
  width:100%;
  height:230px;
  object-fit:contain;
  background:#fff;
}
#omega-push-redesign .or-app-visual-caption{
  display:flex;
  justify-content:space-between;
  gap:15px;
  margin-top:16px;
  color:#5E5951;
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.8px;
}
#omega-push-redesign .or-app-copy p{color:var(--or-muted)}
#omega-push-redesign .or-app-points{
  margin-top:24px;
  border-top:1px solid var(--or-line);
}
#omega-push-redesign .or-app-point{
  display:grid;
  grid-template-columns:35px 1fr;
  gap:14px;
  padding:14px 0;
  border-bottom:1px solid var(--or-line);
}
#omega-push-redesign .or-app-point b{
  color:var(--or-gold);
  font-size:13px;
}
#omega-push-redesign .or-app-point span{
  color:var(--or-muted);
  font-size:12px;
}

/* SPECS - TABLE AND CALLOUT */
#omega-push-redesign .or-spec-header{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:30px;
  margin-bottom:32px;
}
#omega-push-redesign .or-spec-header p{
  color:var(--or-muted);
  max-width:400px;
  font-size:13px;
  margin:0;
}
#omega-push-redesign .or-spec-layout{
  display:grid;
  grid-template-columns:1.35fr .65fr;
  gap:45px;
  align-items:start;
}
#omega-push-redesign .or-spec-table{
  width:100%;
  border-collapse:collapse;
}
#omega-push-redesign .or-spec-table th{
  background:var(--or-dark);
  color:#fff;
  text-align:left;
  padding:15px 16px;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:1px;
}
#omega-push-redesign .or-spec-table td{
  padding:13px 16px;
  font-size:12px;
  border-bottom:1px solid var(--or-line);
  vertical-align:top;
}
#omega-push-redesign .or-spec-table tr:nth-child(even){background:var(--or-paper)}
#omega-push-redesign .or-spec-table td:first-child{
  font-weight:700;
  width:42%;
}
#omega-push-redesign .or-spec-table td:last-child{color:var(--or-muted)}
#omega-push-redesign .or-spec-aside{
  background:var(--or-paper);
  padding:28px;
  border-top:3px solid var(--or-gold);
}
#omega-push-redesign .or-spec-aside h3{font-size:22px}
#omega-push-redesign .or-spec-aside p{color:var(--or-muted);font-size:13px}
#omega-push-redesign .or-spec-highlight{
  border-top:1px solid var(--or-line);
  padding:15px 0;
}
#omega-push-redesign .or-spec-highlight strong{
  display:block;
  font-size:12px;
}
#omega-push-redesign .or-spec-highlight span{
  font-size:12px;
  color:var(--or-muted);
}

/* FEATURE STORY - DARK */
#omega-push-redesign .or-feature-dark{
  background:#111214;
  color:#fff;
  position:relative;
}
#omega-push-redesign .or-feature-dark .or-heading{color:#fff}
#omega-push-redesign .or-feature-dark .or-description{color:rgba(255,255,255,.67)}
#omega-push-redesign .or-feature-top{
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:65px;
  align-items:end;
  margin-bottom:47px;
}
#omega-push-redesign .or-feature-top .or-line{background:var(--or-red)}
#omega-push-redesign .or-feature-matrix{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border-top:1px solid rgba(255,255,255,.2);
  border-left:1px solid rgba(255,255,255,.2);
}
#omega-push-redesign .or-feature-cell{
  min-height:155px;
  padding:22px 19px;
  border-right:1px solid rgba(255,255,255,.2);
  border-bottom:1px solid rgba(255,255,255,.2);
}
#omega-push-redesign .or-feature-cell .or-feature-no{
  color:var(--or-gold);
  font-size:11px;
  display:block;
  margin-bottom:16px;
}
#omega-push-redesign .or-feature-cell h3{
  color:#fff;
  font-size:15px;
  margin-bottom:8px;
}
#omega-push-redesign .or-feature-cell p{
  color:rgba(255,255,255,.62);
  font-size:11px;
  line-height:1.65;
  margin:0;
}

/* FINISH AND DIMENSIONS */
#omega-push-redesign .or-finish-layout{
  display:grid;
  grid-template-columns:.85fr 1.15fr;
  gap:65px;
  align-items:start;
}
#omega-push-redesign .or-finish-intro p{color:var(--or-muted)}
#omega-push-redesign .or-finish-options{
  border-top:1px solid var(--or-line);
}
#omega-push-redesign .or-finish-option{
  display:grid;
  grid-template-columns:58px 1fr;
  gap:20px;
  padding:23px 0;
  border-bottom:1px solid var(--or-line);
}
#omega-push-redesign .or-finish-swatch{
  width:48px;
  height:48px;
  border:1px solid #D6D2CA;
  background:linear-gradient(135deg,#F5F5F3,#B9B9B4);
}
#omega-push-redesign .or-finish-swatch.black{
  background:linear-gradient(135deg,#3A3A3A,#101010);
}
#omega-push-redesign .or-finish-option h3{
  font-size:17px;
  margin-bottom:5px;
}
#omega-push-redesign .or-finish-option p{
  color:var(--or-muted);
  font-size:12px;
  margin:0;
}

/* TECHNICAL DRAWINGS - EDITORIAL LIST */
#omega-push-redesign .or-drawing-head{
  display:grid;
  grid-template-columns:1fr .8fr;
  gap:50px;
  align-items:end;
  margin-bottom:35px;
}
#omega-push-redesign .or-drawing-head p{
  color:var(--or-muted);
  font-size:13px;
  margin:0;
}
#omega-push-redesign .or-drawing-list{
  border-top:1px solid var(--or-line);
}
#omega-push-redesign .or-drawing-row{
  display:grid;
  grid-template-columns:65px 1fr 160px 150px;
  gap:20px;
  align-items:center;
  padding:18px 12px;
  border-bottom:1px solid var(--or-line);
}
#omega-push-redesign .or-drawing-icon{
  color:var(--or-gold);
  font-size:25px;
}
#omega-push-redesign .or-drawing-row h3{
  font-size:15px;
  margin:0 0 4px;
}
#omega-push-redesign .or-drawing-row p{
  font-size:11px;
  color:var(--or-muted);
  margin:0;
}
#omega-push-redesign .or-drawing-code{
  color:var(--or-muted);
  font-size:11px;
}
#omega-push-redesign .or-drawing-row .or-btn{
  min-height:37px;
  padding:8px 12px;
  font-size:10px;
}

/* RELATED PRODUCTS */
#omega-push-redesign .or-related{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:0;
  border-top:1px solid var(--or-line);
  border-left:1px solid var(--or-line);
}
#omega-push-redesign .or-related-item{
  padding:25px;
  min-height:190px;
  border-right:1px solid var(--or-line);
  border-bottom:1px solid var(--or-line);
  background:#fff;
  transition:background .2s ease;
}
#omega-push-redesign .or-related-item:hover{background:var(--or-paper)}
#omega-push-redesign .or-related-item span{
  display:block;
  color:var(--or-gold);
  font-size:10px;
  font-weight:700;
  letter-spacing:1px;
  margin-bottom:13px;
}
#omega-push-redesign .or-related-item h3{
  font-size:17px;
  margin-bottom:8px;
}
#omega-push-redesign .or-related-item p{
  font-size:12px;
  color:var(--or-muted);
  margin-bottom:14px;
}
#omega-push-redesign .or-related-item b{
  font-size:11px;
  color:var(--or-red);
}

/* FAQ */
#omega-push-redesign .or-faq-layout{
  display:grid;
  grid-template-columns:.7fr 1.3fr;
  gap:70px;
  align-items:start;
}
#omega-push-redesign .or-faq-intro{
  position:sticky;
  top:25px;
}
#omega-push-redesign .or-faq-intro p{color:var(--or-muted)}
#omega-push-redesign .or-faq-list{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0 28px;
}
#omega-push-redesign .or-faq-item{
  border-bottom:1px solid #DAD5CC;
  padding:18px 0;
}
#omega-push-redesign .or-faq-item summary{
  cursor:pointer;
  list-style:none;
  position:relative;
  padding-right:27px;
  font-size:13px;
  font-weight:700;
  line-height:1.55;
}
#omega-push-redesign .or-faq-item summary::-webkit-details-marker{display:none}
#omega-push-redesign .or-faq-item summary:after{
  content:"+";
  position:absolute;
  right:2px;
  top:-4px;
  color:var(--or-gold);
  font-size:22px;
  font-weight:400;
}
#omega-push-redesign .or-faq-item[open] summary:after{content:"−"}
#omega-push-redesign .or-faq-item p{
  margin:12px 0 0;
  color:var(--or-muted);
  font-size:12px;
  line-height:1.75;
}

/* FINAL CTA */
#omega-push-redesign .or-final-cta{
  background:var(--or-navy);
  color:#fff;
  padding:70px 0;
  position:relative;
}
#omega-push-redesign .or-final-cta:before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  height:3px;
  width:100%;
  background:var(--or-gold);
}
#omega-push-redesign .or-final-inner{
  display:grid;
  grid-template-columns:1fr auto;
  gap:40px;
  align-items:center;
}
#omega-push-redesign .or-final-cta h2{
  color:#fff;
  font-size:clamp(28px,3.6vw,42px);
  max-width:700px;
}
#omega-push-redesign .or-final-cta p{
  color:rgba(255,255,255,.7);
  max-width:680px;
  margin:0;
}
#omega-push-redesign .or-final-actions{
  display:flex;
  flex-direction:column;
  gap:12px;
  min-width:190px;
}

/* RESPONSIVE */
@media(max-width:950px){
  #omega-push-redesign .or-config-row{
    grid-template-columns:50px 100px 1fr 1fr;
  }
  #omega-push-redesign .or-config-row .or-text-link{
    grid-column:3/5;
    justify-self:start;
  }
  #omega-push-redesign .or-feature-matrix{grid-template-columns:repeat(2,1fr)}
  #omega-push-redesign .or-related{grid-template-columns:1fr 1fr}
}
@media(max-width:680px){
  #omega-push-redesign .or-wrap{width:calc(100% - 34px)}
  #omega-push-redesign .or-section{padding:55px 0}
  #omega-push-redesign .or-hero{padding:53px 0 48px}
